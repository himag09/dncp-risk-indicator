# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ocds_data
# Valores del PostgreSQL de docker-compose.local.yml.
# Para db remota con SSL obligatorio, usar DB_SSLMODE=require.
DB_USER=ocds_user
DB_PASSWORD=ocds_password
DB_SSLMODE=prefer

# Sincronizacion
# Intervalo entre ejecuciones del worker (horas)
SYNC_INTERVAL_HOURS=6
# Fecha inicial del sync si no hay datos historicos
DEFAULT_START_DATE=2026-01-01

# Adaptador DNCP
DNCP_API_BASE_URL=https://www.contrataciones.gov.py/datos/api/v3/doc
DNCP_REQUEST_TOKEN=
DNCP_RATE_LIMIT_SLEEP_SECONDS=60

# Motor de sincronización
SYNC_MAX_CONCURRENT_REQUESTS=3
SOURCE_TIMEZONE=America/Asuncion

# Worker -> API 
INTERNAL_SECRET=change-me
API_INTERNAL_URL=http://api:8000

# Indicadores
# Solo cuentan casos con fecha entre este dia hasta hoy
INDICATORS_START_DATE=2020-01-01

# API
CORS_ALLOW_ORIGINS=*

# Debug
DEBUG=false
DEBUG_FLATTEN_OUTPUT=false
DEBUG_FLATTEN_DIR=data/debug_flatten
