# Plantilla de variables de entorno del frontend.
# Copiar a .env (que NO se commitea) y ajustar según el entorno:
#   cp .env.example .env
#
# Vite solo expone al navegador las variables con prefijo VITE_.

# URL base de la API de indicadores de riesgo (backend DNCP).
# Desarrollo local típico: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000